# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- LLM provider (backend only — never exposed to the frontend) ----
# Get a free key at https://openrouter.ai — works with Gemini, Llama, and more.
LLM_API_KEY=your-openrouter-api-key-here
# OpenAI-compatible base URL. Change to use a different provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model IDs must exist in the provider catalog — a withdrawn ID at position 0
# costs a failover, not the stage. Verify with:
#   curl -s https://openrouter.ai/api/v1/models | grep '"id"'
# or run: pytest -m live_models  (from repo root or backend/, either works)
#
# ---- Model failover pools ----
# Ordered, comma-separated model ids (strongest first). Position 0 is what runs
# on a healthy request; the app fails over down the list when a model returns
# HTTP 429 (rate-limited). Set either var to the literal "auto" to instead
# discover free models from OpenRouter's catalog at runtime — your account's
# allowed-models list then gates which are actually used (zero local change when
# you add/remove models on OpenRouter).
#
# Synthesis reads every retained paper in one call, so its pool is filtered to
# long-context models; rerank, extract, and expand share the rerank pool.
LLM_SYNTHESIS_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,minimax/minimax-m3:free
LLM_RERANK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# When a model is rate-limited, skip it for this long (fallback if the upstream
# Retry-After header is absent), and how long to cache the auto-discovered list.
LLM_COOLDOWN_SECONDS=60
LLM_MODELS_CACHE_TTL=3600

# Legacy single-model vars (still honored if the *_MODELS pools are unset).
LLM_SYNTHESIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_RERANK_MODEL=google/gemma-4-31b-it:free
#
# All defaults are free-tier models, so a fresh clone costs nothing but a full
# run takes 3-5 minutes and extraction completeness varies with rate limits. For
# seconds-not-minutes at roughly $0.0025/run, put a cheap paid model at position
# 0 of LLM_RERANK_MODELS, e.g. openai/gpt-oss-120b ($0.03/$0.17 per 1M tokens).

# Off by default: OpenRouter's /embeddings coverage is much narrower than its
# chat-completions catalog — confirm your LLM_BASE_URL/model combo actually
# supports embeddings before enabling. Any failure falls back to unfiltered
# candidates automatically, so this can only cost latency on a bad config,
# never recall.
EMBED_PREFILTER_ENABLED=false
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBED_PREFILTER_KEEP=20
#
# Off by default: fetches + parses a PDF from arxiv.org for each of the top
# FULL_TEXT_TOP_N papers by rerank score, adding real seconds of latency per
# paper and a network dependency. Abstracts rarely contain hard numbers, so
# this gives extraction's "results" field something concrete to draw from for
# the handful of papers a run cares most about. Any fetch/parse failure falls
# back to abstract-only extraction for that paper, silently.
FULL_TEXT_ENABLED=false
FULL_TEXT_TOP_N=5
FULL_TEXT_MAX_CHARS=6000

# ---- Pipeline bounds (cost control) ----
MAX_CANDIDATES=50
MAX_RETAINED_PAPERS=18
MAX_CONCURRENT_RUNS=3
DAILY_TOKEN_BUDGET=2000000
RATE_LIMIT_PER_MINUTE=10
# Parallel extraction calls. Keep low on free tiers: pushing concurrency into a
# rate limit lowers how many papers complete, it does not speed the run up.
EXTRACT_CONCURRENCY=3

# ---- arXiv ----
ARXIV_PAGE_SIZE=50
# How many arXiv queries to generate from one plain-English topic.
EXPAND_QUERIES=5
# Optional category filter, comma-separated (e.g. cs.LG,cs.CL). Empty means no
# filter — a narrow list silently drops papers from adjacent categories.
ARXIV_CATEGORIES=

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS. The UI is served same-origin by this
# app; these only matter for cross-origin API clients. No wildcards.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---- Storage (v1) ----
DATABASE_URL=sqlite:///./data/app.db

# ---- Frontend (safe to expose; must be NEXT_PUBLIC_*) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
