# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- LLM provider (backend only — never exposed to the frontend) ----
# Get a free key at https://openrouter.ai — works with Gemini, Llama, and more.
LLM_API_KEY=your-openrouter-api-key-here
# OpenAI-compatible base URL. Change to use a different provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model IDs must exist in the provider catalog — a withdrawn ID fails the whole
# stage at runtime. Verify with:
#   curl -s https://openrouter.ai/api/v1/models | grep '"id"'
# or run: cd backend && pytest -m live_models
#
# Model used for cross-paper synthesis (most capable).
LLM_SYNTHESIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Reranking candidates by relevance (fast, reliable JSON output).
LLM_RERANK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Per-paper extraction. Split from rerank so accuracy and cost can be tuned apart.
LLM_EXTRACT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Turning a plain-English topic into arXiv query syntax (one cheap call).
LLM_EXPAND_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#
# All four defaults are free-tier models, so a fresh clone costs nothing but a
# full run takes 3-5 minutes and extraction completeness varies with rate limits.
# For seconds-not-minutes at roughly $0.0025/run, switch rerank/extract/expand to
# a cheap paid model, e.g. openai/gpt-oss-120b ($0.03/$0.17 per 1M tokens).

# ---- Pipeline bounds (cost control) ----
MAX_CANDIDATES=50
MAX_RETAINED_PAPERS=18
MAX_CONCURRENT_RUNS=3
DAILY_TOKEN_BUDGET=2000000
RATE_LIMIT_PER_MINUTE=10
# Parallel extraction calls. Keep low on free tiers: pushing concurrency into a
# rate limit lowers how many papers complete, it does not speed the run up.
EXTRACT_CONCURRENCY=3

# ---- arXiv ----
ARXIV_PAGE_SIZE=50
# How many arXiv queries to generate from one plain-English topic.
EXPAND_QUERIES=5
# Optional category filter, comma-separated (e.g. cs.LG,cs.CL). Empty means no
# filter — a narrow list silently drops papers from adjacent categories.
ARXIV_CATEGORIES=

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS. The UI is served same-origin by this
# app; these only matter for cross-origin API clients. No wildcards.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---- Storage (v1) ----
DATABASE_URL=sqlite:///./data/app.db

# ---- Frontend (safe to expose; must be NEXT_PUBLIC_*) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
